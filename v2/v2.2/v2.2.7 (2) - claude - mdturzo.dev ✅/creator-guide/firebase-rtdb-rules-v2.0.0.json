{
  "rules": {

    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",
        ".write": false
      }
    },

    "notifications": {
      ".read": "auth !== null",
      ".write": false,

      "$notifId": {
        ".read": "auth !== null",
        ".write": "auth !== null && root.child('admins').child(auth.uid).exists()"
      }
    },

    "notification_reads": {
      "$uid": {
        ".read":  "auth !== null && auth.uid === $uid",
        ".write": "auth !== null && auth.uid === $uid",

        "$notifId": {
          ".validate": "newData.hasChildren(['readAt'])"
        }
      }
    },

    "presence": {
      ".read": "auth !== null",

      "$uid": {
        ".read":  "auth !== null",
        ".write": "auth !== null && auth.uid === $uid",

        ".validate": "newData.hasChildren(['online', 'lastSeen'])"
      }
    },

    "site_status": {
      ".read": true,
      ".write": "auth !== null && root.child('admins').child(auth.uid).exists()"
    },

    "banners": {
      ".read": true,
      ".write": "auth !== null && root.child('admins').child(auth.uid).exists()",

      "$bannerId": {
        ".validate": "newData.hasChildren(['message', 'type', 'active'])"
      }
    },

    "typing_indicators": {
      "$contentId": {
        "$uid": {
          ".read":  "auth !== null",
          ".write": "auth !== null && auth.uid === $uid",

          ".validate": "newData.isBoolean()"
        }
      }
    },

    "live_visitors": {
      ".read": "auth !== null && root.child('admins').child(auth.uid).exists()",
      ".write": false,

      "$uid": {
        ".write": "auth !== null && auth.uid === $uid"
      }
    },

    "user_tokens": {
      "$uid": {
        ".read":  "auth !== null && auth.uid === $uid",
        ".write": "auth !== null && auth.uid === $uid"
      }
    }
  }
}
